# Copy this file to .env and fill in your own credentials.
# .env is gitignored. Do not commit real keys.

# Server酱 SendKey. Required for WeChat push.
# ServerChanNotifier rejects an empty value.
SERVERCHAN_KEY=

# Zhipu GLM API key. Optional.
# When empty, scoring, summaries, research, and run_agent_task stay disabled.
ZHIPU_API_KEY=

# Baidu translation. Optional.
# The translator stays disabled unless both values are set.
BAIDU_FANYI_APPID=
BAIDU_FANYI_SECRET=
